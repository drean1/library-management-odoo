<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- List view -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-muted="not available">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn" optional="show"/>
                <field name="stock" sum="Total Stock"/>
                <field name="available" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <kanban sample="1" class="o_kanban_mobile">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="stock"/>
                <field name="available"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2">
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold fs-5"/>
                                <div class="text-muted">
                                    <field name="author"/>
                                </div>
                            </div>
                            <span t-if="record.available.raw_value" class="badge rounded-pill text-bg-success">Available</span>
                            <span t-else="" class="badge rounded-pill text-bg-secondary">Unavailable</span>
                        </div>
                        <div class="mt-3 d-flex justify-content-between text-muted">
                            <span>
                                ISBN:
                                <field name="isbn"/>
                            </span>
                            <span>
                                Stock:
                                <field name="stock"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name" string="Book" filter_domain="['|', '|', ('name', 'ilike', self), ('author', 'ilike', self), ('isbn', 'ilike', self)]"/>
                <field name="author"/>
                <field name="isbn"/>
                <separator/>
                <filter name="available" string="Available" domain="[('available', '=', True)]"/>
                <filter name="unavailable" string="Unavailable" domain="[('available', '=', False)]"/>
                <filter name="in_stock" string="In Stock" domain="[('stock', '&gt;', 0)]"/>
                <group>
                    <filter name="group_by_author" string="Author" context="{'group_by': 'author'}"/>
                    <filter name="group_by_available" string="Availability" context="{'group_by': 'available'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Book Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Clean Code"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Book Details">
                            <field name="author" placeholder="Author name"/>
                            <field name="isbn" placeholder="ISBN number"/>
                        </group>
                        <group string="Inventory">
                            <field name="stock"/>
                            <field name="available" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library_book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first book
            </p>
            <p>
                Track book details, ISBN, stock, and availability from one place.
            </p>
        </field>
    </record>
    </data>
</odoo>
