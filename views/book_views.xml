<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Tree/list view-->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library_book_list</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <list string="Book">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--Form view-->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library_book_form</field>
        <field name="model">library_book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <!-- Kolom Kiri -->
                        <group>
                            <field name="name"/>
                            <field name="isbn"/>
                            <field name="available"/>
                        </group>
                        <!-- Kolom Kanan -->
                        <group>
                            <field name="author"/>
                            <field name="stock"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Window Action-->
    <record id="library_book_action" model="ir.actions.act_window">
    <field name="name">Library action</field>
    <field name="res_model">library_book</field>
    <field name="view_mode">list,form</field>
    </record>
</odoo>